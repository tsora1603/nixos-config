#!/usr/bin/env bash
#
# plasma-always-floating-panel-patch -- keep KDE Plasma 6 panels floating unconditionally.
#
# Two edits to Panel.qml:
#
#  1. Upstream binds `touchingWindowDirect` to `visibleWindowsModel.count > 0`, which drives
#     `floatingnessTarget` to 0 whenever a window touches the panel, docking it flush against
#     the screen edge. Pinned to `false`, the panel keeps floating.
#
#  2. The strut KWin reserves for a panel is just its `thickness`, computed in C++, while a
#     floating panel draws itself `thickness` tall offset inwards by the floating gap. The
#     panel therefore overhangs the reserved area by that gap and covers the edge of any
#     maximized window. Anchoring the background to the screen-edge side and taking the gap
#     out of the drawn thickness instead lines the panel's inner edge up with the window edge.
#     Consequence: the visible bar is `thickness - gap`, so `thickness` now describes the
#     panel's whole footprint, gap included.
#
# The patch is applied to a *copy* of the shell package under the user's data directory.
# KPackage prefers $XDG_DATA_HOME over the system prefix, so the system files are never
# touched and no root privileges are required. The trade-off is that the copy shadows the
# entire package, so it must be refreshed from the system copy whenever Plasma is updated
# -- see the systemd user unit generated by this script.
#
# SPDX-License-Identifier: GPL-2.0-or-later

set -euo pipefail

readonly PROG=plasma-always-floating-panel-patch
readonly PKG_ID=org.kde.plasma.desktop
readonly QML_REL=contents/views/Panel.qml
readonly STAMP=.plasma-always-floating-panel-patch
readonly HOMEPAGE=https://github.com/illatillmods/plasma-always-floating-panel-patch
readonly KWIN_SCRIPT_ID=plasma-always-floating-panel-resize-snap

# Markers proving each edit landed. If upstream ever moves out from under them the patch
# is abandoned wholesale rather than half-applied.
readonly PATCHED='property bool touchingWindowDirect: false'
readonly ALIGNED='panel.thickness - root.outerFloatingPadding'
readonly ALIGNED_COUNT=4

readonly USER_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
readonly DEST="$USER_DATA_HOME/plasma/shells/$PKG_ID"

# Width of the floating gap. Comes from the panel-background SVG's `floating` prefix, whose
# fallback -- and Breeze's value -- is 8. Override for a theme that uses something else.
readonly FLOATING_GAP=${PLASMA_FLOATING_GAP:-8}

# How much thickness was added per panel, kept outside the override so uninstall can undo
# exactly what was added even though the override itself gets rebuilt on every refresh.
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$PROG"
readonly THICKNESS_STATE="$STATE_DIR/thickness"

# Restart the shell after install/uninstall so the change is visible immediately.
RESTART=1

log()  { printf '%s: %s\n' "$PROG" "$*" >&2; }
warn() { printf '%s: WARNING: %s\n' "$PROG" "$*" >&2; }
die()  { printf '%s: ERROR: %s\n' "$PROG" "$*" >&2; exit 1; }

usage() {
	cat <<EOF
$PROG -- keep KDE Plasma 6 panels floating unconditionally

Usage: $PROG <command> [--no-restart]

Commands:
  install     Create the patched shell override and enable the refresh unit
  refresh     Re-copy from the system package and re-apply the patch
  adjust      Grow panels that install missed, e.g. ones added later
  uninstall   Remove the override and the refresh unit
  status      Report what is currently installed
  help        Show this message

install grows each floating panel's reserved space by the floating gap so the visible
bar keeps its size while maximized windows stop at the panel's edge. The amount is
recorded and given back on uninstall. Set PLASMA_FLOATING_GAP if your theme's gap is
not ${FLOATING_GAP}px.

install also enables a small KWin script that keeps resize snapping on the correct
screen in multi-monitor layouts.

install and uninstall restart plasmashell so the change takes effect right away.
Pass --no-restart to skip that and do it yourself:
  systemctl --user restart plasma-plasmashell.service

Home page: $HOMEPAGE
EOF
}

# Locate the *system* copy of the shell package, skipping the user override.
find_system_package() {
	local dirs=() d resolved
	IFS=: read -r -a dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
	dirs+=(/usr/share /usr/local/share)

	for d in "${dirs[@]}"; do
		[[ -n $d ]] || continue
		resolved=$(readlink -f -- "$d" 2>/dev/null) || continue
		[[ $resolved == "$(readlink -f -- "$USER_DATA_HOME" 2>/dev/null)" ]] && continue
		if [[ -f "$resolved/plasma/shells/$PKG_ID/$QML_REL" ]]; then
			printf '%s\n' "$resolved/plasma/shells/$PKG_ID"
			return 0
		fi
	done
	return 1
}

plasma_eval() {
	local c
	for c in qdbus6 qdbus-qt6 qdbus; do
		command -v "$c" >/dev/null 2>&1 || continue
		"$c" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$1" 2>/dev/null && return 0
		return 1
	done
	return 1
}

kwin_call() {
	local c
	for c in qdbus6 qdbus-qt6 qdbus; do
		command -v "$c" >/dev/null 2>&1 || continue
		"$c" org.kde.KWin "$@"
		return
	done
	return 1
}

resize_snap_installed() {
	command -v kpackagetool6 >/dev/null 2>&1 &&
		kpackagetool6 --type KWin/Script --show "$KWIN_SCRIPT_ID" >/dev/null 2>&1
}

write_resize_snap_package() {
	local package=$1
	mkdir -p -- "$package/contents/code"

	cat >"$package/metadata.json" <<'KWIN_METADATA'
{
    "KPackageStructure": "KWin/Script",
    "KPlugin": {
        "Description": "Keep resize snapping on the correct screen in multi-monitor layouts",
        "EnabledByDefault": false,
        "Id": "plasma-always-floating-panel-resize-snap",
        "License": "GPL-2.0-or-later",
        "Name": "Floating Panel Resize Snap",
        "Version": "1.0"
    },
    "X-Plasma-API": "javascript"
}
KWIN_METADATA

	cat >"$package/contents/code/main.js" <<'KWIN_JAVASCRIPT'
// SPDX-License-Identifier: GPL-2.0-or-later

const EDGE_HINT = 24;
const resizeOperations = new Map();

function copyGeometry(geometry) {
    return {
        x: geometry.x,
        y: geometry.y,
        width: geometry.width,
        height: geometry.height,
    };
}

function resizingEdges(geometry, cursor) {
    const right = geometry.x + geometry.width;
    const bottom = geometry.y + geometry.height;
    const leftDistance = Math.abs(cursor.x - geometry.x);
    const rightDistance = Math.abs(cursor.x - right);
    const topDistance = Math.abs(cursor.y - geometry.y);
    const bottomDistance = Math.abs(cursor.y - bottom);
    const edgeBand = Math.min(EDGE_HINT, geometry.width / 3, geometry.height / 3);
    const nearHorizontalEdge = Math.min(leftDistance, rightDistance) <= edgeBand;
    const nearVerticalEdge = Math.min(topDistance, bottomDistance) <= edgeBand;
    const edges = { left: false, top: false, right: false, bottom: false };

    if (nearHorizontalEdge || nearVerticalEdge) {
        if (nearHorizontalEdge) {
            edges[leftDistance <= rightDistance ? "left" : "right"] = true;
        }
        if (nearVerticalEdge) {
            edges[topDistance <= bottomDistance ? "top" : "bottom"] = true;
        }
        return edges;
    }

    // Alt+right-drag can begin anywhere inside a window. Match KWin's thirds-based gravity.
    const x = cursor.x - geometry.x;
    const y = cursor.y - geometry.y;
    const left = x < geometry.width / 3;
    const rightThird = x >= 2 * geometry.width / 3;
    const top = y < geometry.height / 3;
    const bottomThird = y >= 2 * geometry.height / 3;

    if (top) {
        edges.top = true;
        if (left) {
            edges.left = true;
        } else if (rightThird) {
            edges.right = true;
        }
    } else if (bottomThird) {
        edges.bottom = true;
        if (left) {
            edges.left = true;
        } else if (rightThird) {
            edges.right = true;
        }
    } else {
        edges[x < geometry.width / 2 ? "left" : "right"] = true;
    }
    return edges;
}

function shouldSnap(value, target, positiveDirection) {
    const distance = Math.abs(value - target);
    if (distance === 0 || distance >= options.borderSnapZone) {
        return false;
    }
    return !options.snapOnlyWhenOverlapping
        || (positiveDirection ? value > target : value < target);
}

function snapResize(window, geometry) {
    const operation = resizeOperations.get(window);
    if (!operation || operation.applying || !window.resize || options.borderSnapZone <= 0) {
        return;
    }

    const output = workspace.screenAt({
        x: geometry.x + geometry.width / 2,
        y: geometry.y + geometry.height / 2,
    });
    const nativeOutput = workspace.screenAt({
        x: window.width / 2,
        y: window.height / 2,
    });
    if (!output || output === nativeOutput) {
        return;
    }

    const desktop = workspace.currentDesktopForScreen(output) || workspace.currentDesktop;
    const area = workspace.clientArea(KWin.MaximizeArea, output, desktop);
    const areaRight = area.x + area.width;
    const areaBottom = area.y + area.height;
    const snapped = copyGeometry(geometry);
    let changed = false;

    if (operation.edges.left && shouldSnap(snapped.x, area.x, false)) {
        const fixedRight = snapped.x + snapped.width;
        snapped.x = area.x;
        snapped.width = fixedRight - snapped.x;
        changed = true;
    }
    if (operation.edges.right
        && shouldSnap(snapped.x + snapped.width, areaRight, true)) {
        snapped.width = areaRight - snapped.x;
        changed = true;
    }
    if (operation.edges.top && shouldSnap(snapped.y, area.y, false)) {
        const fixedBottom = snapped.y + snapped.height;
        snapped.y = area.y;
        snapped.height = fixedBottom - snapped.y;
        changed = true;
    }
    if (operation.edges.bottom
        && shouldSnap(snapped.y + snapped.height, areaBottom, true)) {
        snapped.height = areaBottom - snapped.y;
        changed = true;
    }

    if (changed && snapped.width > 0 && snapped.height > 0) {
        operation.applying = true;
        try {
            window.frameGeometry = snapped;
        } finally {
            operation.applying = false;
        }
    }
}

function watchWindow(window) {
    if (window.specialWindow) {
        return;
    }

    window.interactiveMoveResizeStarted.connect(() => {
        resizeOperations.delete(window);
        if (!window.resize || !window.resizeable || workspace.screens.length < 2) {
            return;
        }
        resizeOperations.set(window, {
            applying: false,
            edges: resizingEdges(copyGeometry(window.frameGeometry), workspace.cursorPos),
        });
    });
    window.interactiveMoveResizeStepped.connect(geometry => snapResize(window, geometry));
    window.interactiveMoveResizeFinished.connect(() => resizeOperations.delete(window));
    window.closed.connect(() => resizeOperations.delete(window));
}

workspace.windowList().forEach(watchWindow);
workspace.windowAdded.connect(watchWindow);
KWIN_JAVASCRIPT
}

# KWin needs a package directory, but it is generated only while kpackagetool6 consumes it;
# keeping the payload here makes the installed copy of this script fully self-contained.
install_resize_snap() (
	command -v kpackagetool6 >/dev/null 2>&1 ||
		die "kpackagetool6 not found; cannot install the resize-snap workaround"
	command -v kwriteconfig6 >/dev/null 2>&1 ||
		die "kwriteconfig6 not found; cannot enable the resize-snap workaround"

	local package
	package=$(mktemp -d -- "${TMPDIR:-/tmp}/$PROG.kwin.XXXXXX") ||
		die "could not create temporary KWin package"
	trap 'rm -rf -- "$package"' EXIT
	write_resize_snap_package "$package"

	# Drop the running copy before an upgrade so KWin reads the new file.
	kwin_call /Scripting org.kde.kwin.Scripting.unloadScript "$KWIN_SCRIPT_ID" \
		>/dev/null 2>&1 || true
	if resize_snap_installed; then
		kpackagetool6 --type KWin/Script --upgrade "$package" >/dev/null
	else
		kpackagetool6 --type KWin/Script --install "$package" >/dev/null
	fi

	kwriteconfig6 --file kwinrc --group Plugins --key "${KWIN_SCRIPT_ID}Enabled" \
		--type bool true
	if kwin_call /Scripting org.kde.kwin.Scripting.start >/dev/null 2>&1; then
		local running
		running=$(kwin_call /Scripting org.kde.kwin.Scripting.isScriptLoaded \
			"$KWIN_SCRIPT_ID" 2>/dev/null || true)
		if [[ $running == true ]]; then
			log "enabled resize snapping at the panel edge"
		else
			warn "the resize-snap script was installed but KWin did not load it"
		fi
	else
		warn "KWin is not reachable; resize snapping will load at the next login"
	fi
)

remove_resize_snap() {
	kwin_call /Scripting org.kde.kwin.Scripting.unloadScript "$KWIN_SCRIPT_ID" \
		>/dev/null 2>&1 || true
	if resize_snap_installed; then
		kpackagetool6 --type KWin/Script --remove "$KWIN_SCRIPT_ID" >/dev/null ||
			warn "could not remove the KWin resize-snap script"
	fi
	if command -v kwriteconfig6 >/dev/null 2>&1; then
		kwriteconfig6 --file kwinrc --group Plugins --key "${KWIN_SCRIPT_ID}Enabled" --delete
	fi
}

# List floating panels as "id:thickness" tokens. Plasma concatenates successive print() calls
# without separators, so build one string and print it once.
list_floating_panels() {
	plasma_eval 'var o = []; panels().forEach(function(p) { if (p.floating) o.push(p.id + ":" + p.height); }); print(o.join(" "));'
}

set_panel_thickness() {
	plasma_eval "panels().forEach(function(p) { if (p.id === $1) p.height = $2; });" >/dev/null
}

# Add the gap to each floating panel's thickness. The patch takes the gap out of the drawn
# thickness, so this leaves the visible bar exactly the size it was while the reserved strut
# grows -- which is what pulls maximized windows back to the panel's edge.
grow_panels() {
	local listing entry id thickness grown=0

	if ! listing=$(list_floating_panels); then
		warn "could not reach plasmashell, so panel thickness was left alone."
		warn "the visible bar will be ${FLOATING_GAP}px thinner until you run, with the shell up:"
		warn "  $PROG adjust"
		return 0
	fi

	mkdir -p -- "$STATE_DIR"
	touch -- "$THICKNESS_STATE"

	for entry in $listing; do
		id=${entry%%:*}
		thickness=${entry##*:}
		[[ $id =~ ^[0-9]+$ && $thickness =~ ^[0-9]+$ ]] || continue
		grep -q "^$id " -- "$THICKNESS_STATE" && continue # already grown

		if set_panel_thickness "$id" "$((thickness + FLOATING_GAP))"; then
			printf '%s %s\n' "$id" "$FLOATING_GAP" >>"$THICKNESS_STATE"
			grown=$((grown + 1))
		fi
	done

	[[ $grown -gt 0 ]] &&
		log "grew $grown panel(s) by ${FLOATING_GAP}px of reserved space; visible size unchanged"
	return 0
}

# Undo grow_panels. Subtracts rather than restoring an absolute value, so a thickness the user
# changed in the meantime keeps their adjustment.
shrink_panels() {
	[[ -f $THICKNESS_STATE ]] || return 0
	local id delta failed=0

	while read -r id delta; do
		[[ $id =~ ^[0-9]+$ && $delta =~ ^[0-9]+$ ]] || continue
		plasma_eval "panels().forEach(function(p) { if (p.id === $id && p.height > $delta) p.height = p.height - $delta; });" \
			>/dev/null || failed=1
	done <"$THICKNESS_STATE"

	if [[ $failed -eq 0 ]]; then
		rm -f -- "$THICKNESS_STATE"
		rmdir -- "$STATE_DIR" 2>/dev/null || true
		log "returned the reserved space to the panels"
	else
		warn "could not reach plasmashell; panel thickness left as it is."
		warn "what was added is still recorded in $THICKNESS_STATE"
	fi
}

restart_shell() {
	local unit=plasma-plasmashell.service
	if [[ $RESTART -eq 0 ]]; then
		log "not restarting; apply with: systemctl --user restart $unit"
	elif command -v systemctl >/dev/null 2>&1 &&
		systemctl --user is-active --quiet "$unit" 2>/dev/null; then
		log "restarting plasmashell..."
		systemctl --user restart "$unit" ||
			warn "restart failed; run it yourself: systemctl --user restart $unit"
	else
		log "plasmashell is not running under systemd; log out and back in to apply"
	fi
}

is_patched() {
	[[ -f "$DEST/$QML_REL" ]] &&
		grep -Fq "$PATCHED" -- "$DEST/$QML_REL" &&
		grep -Fq "$ALIGNED" -- "$DEST/$QML_REL"
}

# Rewrite Panel.qml in place. Every edit must land or the caller throws the file away, so
# each one is verified at the end rather than trusted.
patch_qml() {
	local qml=$1

	# Never de-float.
	sed -i 's|^\( *\)property bool touchingWindowDirect: visibleWindowsModel\.count > 0$|\1// Pinned false so floatingnessTarget stays 1 and the panel never docks.\n\1property bool touchingWindowDirect: false|' -- "$qml"

	# The floating gap on the screen-edge side. Animated, so it collapses to 0 when the panel
	# is not floating and the stock geometry is left exactly as it was.
	sed -i 's|^\( *\)readonly property int topFloatingPadding: \(.*\)$|\1readonly property int topFloatingPadding: \2\n\n\1// The floating gap on the screen-edge side of the panel.\n\1readonly property int outerFloatingPadding: verticalPanel\n\1    ? (rightEdge ? rightFloatingPadding : leftFloatingPadding)\n\1    : (bottomEdge ? bottomFloatingPadding : topFloatingPadding)|' -- "$qml"

	# Keep the background pinned to the screen-edge side instead of letting it ride inwards
	# as it floats, so its inner edge does not move.
	sed -i 's| \* (1 - root\.floatingness)||g' -- "$qml"

	# Take the gap out of the drawn thickness. Applies to both the background and the applet
	# area, which is centred on it.
	sed -i \
		-e 's|? panel\.thickness :|? panel.thickness - root.outerFloatingPadding :|g' \
		-e 's|: panel\.thickness$|: panel.thickness - root.outerFloatingPadding|g' \
		-- "$qml"

	grep -Fq "$PATCHED" -- "$qml" &&
		grep -Fq 'readonly property int outerFloatingPadding:' -- "$qml" &&
		! grep -Fq '(1 - root.floatingness)' -- "$qml" &&
		[[ $(grep -Fc "$ALIGNED" -- "$qml") -eq $ALIGNED_COUNT ]]
}

# Build a fresh patched copy and swap it into place. Returns 0 if the patch applied,
# 1 if it could not (a clean unpatched copy is installed instead, never a stale one).
build_override() {
	local src staging old rc=0
	src=$(find_system_package) || die "could not find the system $PKG_ID shell package"

	staging="$DEST.new.$$"
	old="$DEST.old.$$"
	# shellcheck disable=SC2064
	trap "rm -rf -- '$staging'" RETURN

	rm -rf -- "$staging"
	mkdir -p -- "$(dirname -- "$DEST")"
	cp -a -- "$src" "$staging"
	chmod -R u+w -- "$staging"

	local qml="$staging/$QML_REL"
	[[ -f $qml ]] || die "$QML_REL missing from $src -- refusing to install a broken override"

	patch_qml "$qml" || {
		rc=1
		warn "Panel.qml no longer matches what this patch expects."
		warn "installing a clean UNPATCHED override; the panel behaves as it does by default."
		warn "this usually means Plasma refactored Panel.qml -- please report it at:"
		warn "  $HOMEPAGE/issues"
		# All-or-nothing: restore the single file we touch, never ship a half-patch.
		cp -a --remove-destination -- "$src/$QML_REL" "$qml"
	}

	printf '%s\n' \
		"# Generated by $PROG. Do not edit; it is overwritten on every refresh." \
		"source=$src" \
		"patched=$([[ $rc -eq 0 ]] && echo yes || echo no)" \
		>"$staging/$STAMP"

	[[ -d $DEST ]] && mv -- "$DEST" "$old"
	if ! mv -- "$staging" "$DEST"; then
		[[ -d $old ]] && mv -- "$old" "$DEST"
		die "failed to install the override"
	fi
	rm -rf -- "$old"

	# Stale compiled QML can mask the change on the next start.
	rm -rf -- "${XDG_CACHE_HOME:-$HOME/.cache}/plasmashell/qmlcache"

	return $rc
}

cmd_install() {
	if [[ -d $DEST && ! -f "$DEST/$STAMP" ]]; then
		die "$DEST already exists and is not managed by this patch"
	fi

	build_override && log "patched override installed at $DEST" || true
	grow_panels
	install_resize_snap
	restart_shell
	log "done"
}

cmd_adjust() {
	[[ -d $DEST ]] || die "nothing installed; run '$PROG install' first"
	grow_panels
	log "done"
}

cmd_refresh() {
	if [[ -d $DEST && ! -f "$DEST/$STAMP" ]]; then
		die "$DEST already exists and is not managed by this patch"
	fi

	build_override && log "refreshed $DEST" || true
}

cmd_uninstall() {
	shrink_panels
	remove_resize_snap

	if [[ -d $DEST && ! -f "$DEST/$STAMP" ]]; then
		warn "$DEST was not created by $PROG; leaving it alone"
	else
		rm -rf -- "$DEST"
		log "removed $DEST"
	fi

	rm -rf -- "${XDG_CACHE_HOME:-$HOME/.cache}/plasmashell/qmlcache"
	restart_shell
	log "done"
}

cmd_status() {
	local src
	if src=$(find_system_package); then
		printf 'system package : %s\n' "$src"
	else
		printf 'system package : NOT FOUND\n'
	fi

	if [[ -d $DEST ]]; then
		printf 'override       : %s\n' "$DEST"
		printf 'patched        : %s\n' "$(is_patched && echo yes || echo 'no (panels will dock)')"
		printf 'created by us  : %s\n' "$([[ -f "$DEST/$STAMP" ]] && echo yes || echo no)"
	else
		printf 'override       : not installed\n'
	fi

	if [[ -s $THICKNESS_STATE ]]; then
		printf 'grown panels   : %s (+%spx reserved each, returned on uninstall)\n' \
			"$(wc -l <"$THICKNESS_STATE")" "$FLOATING_GAP"
	else
		printf 'grown panels   : none\n'
	fi

	if command -v systemctl >/dev/null 2>&1; then
		local state
		state=$(systemctl --user is-enabled "$UNIT_NAME" 2>/dev/null || true)
		[[ -z $state || $state == not-found ]] && state='not enabled'
		printf 'refresh unit   : %s\n' "$state"
	fi

	if command -v kpackagetool6 >/dev/null 2>&1; then
		printf 'kpackage uses  : %s\n' \
			"$(kpackagetool6 --type Plasma/Shell --show "$PKG_ID" 2>/dev/null | awk -F': *' '/Path/{print $2; exit}')"
	fi

	local resize_snap=not-installed enabled=unknown running=not-running
	if resize_snap_installed; then
		resize_snap=installed
		if command -v kreadconfig6 >/dev/null 2>&1; then
			enabled=$(kreadconfig6 --file kwinrc --group Plugins \
				--key "${KWIN_SCRIPT_ID}Enabled" --default false)
		fi
		running=$(kwin_call /Scripting org.kde.kwin.Scripting.isScriptLoaded \
			"$KWIN_SCRIPT_ID" 2>/dev/null || echo unknown)
	fi
	printf 'resize snap    : %s, enabled=%s, running=%s\n' \
		"$resize_snap" "$enabled" "$running"
}

main() {
	local cmd=${1-status} arg
	[[ $# -gt 0 ]] && shift

	for arg in "$@"; do
		case $arg in
		--no-restart) RESTART=0 ;;
		*) usage >&2; die "unknown option: $arg" ;;
		esac
	done

	case "$cmd" in
	install) cmd_install ;;
	refresh) cmd_refresh ;;
	adjust) cmd_adjust ;;
	uninstall) cmd_uninstall ;;
	status) cmd_status ;;
	help | -h | --help) usage ;;
	*) usage >&2; die "unknown command: $cmd" ;;
	esac
}

main "$@"
